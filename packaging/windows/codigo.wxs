<?xml version="1.0" encoding="utf-8"?>
<!--
  Código MSI (WiX Toolset v5: `dotnet tool install -g wix --version 5.0.2`, plus the UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`).
  Built by package.ps1:

    wix build codigo.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc codigo.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-user install (no UAC prompt), by default into %LOCALAPPDATA%\Programs\Nodalia\Codigo, plus a
  Start Menu shortcut carrying the AppUserModelID dev.danielmiguelt.Codigo (the taskbar groups
  windows by it). No file associations. Código updates itself without elevation because
  the folder is the user's.

  Double-clicked, it opens a setup wizard that names the version: Welcome; a folder page; Ready; a
  progress page; and a Finish page with a ticked "Launch Código" box. There is no licence page (the
  code is MIT OR Apache-2.0; nothing to accept). The install folder is recorded under HKCU and
  reused by later versions, so an update (`msiexec /i ... /passive`) lands in the same folder.

  Per-user packages can't use a file as a component's KeyPath (ICE38), so each component is keyed
  on an HKCU value, and the folders we create are removed on uninstall (ICE64).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Código"
      Manufacturer="Nodalia"
      Version="$(var.Version)"
      UpgradeCode="6D2B4A3E-9C51-4F0A-8E57-3B7A1C9D2E64"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Código: the Nodalia code editor and IDE" Manufacturer="Nodalia" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Código is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The Apps & features icon only (MSI caches it under its Id; keep the .exe extension,
         ICE50). The shortcuts use the exe's own icon, which build.rs embeds. -->
    <Icon Id="CodigoIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CodigoIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getnodalia.com/codigo" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/getnodalia/codigo/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/getnodalia/codigo/issues" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="NodaliaSuiteFolder" Name="Nodalia">
          <Directory Id="INSTALLFOLDER" Name="Codigo" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An update installs where the user put the previous version (recorded by CodigoApp below). -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\Nodalia\Codigo" Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="CodigoRestoreFolder" Value="[PREVIOUSINSTALLFOLDER]"
        Before="CostInitialize" Sequence="both" Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />

    <Feature Id="Main" Title="Código" Level="1">
      <ComponentGroupRef Id="CodigoFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page. Later NewDialog events on
         the same button win. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="4" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="4" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchCodigo"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, drawn by package.ps1 from the app icon. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through codigo.en-us.wxl. -->
    <Property Id="CodigoVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: offer to start Código (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Código $(var.DisplayVersion) is installed. Start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Código" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#CodigoExe]" />
    <!-- Runs in the wizard's own process, so Código starts as the user. -->
    <CustomAction Id="LaunchCodigo" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="CodigoFiles">
      <Component Id="CodigoApp" Directory="INSTALLFOLDER" Guid="B1A7E4C2-5D38-4B9F-A0E6-72C3F18D5A09">
        <File Id="CodigoExe" Source="$(var.BinDir)\codigo.exe" KeyPath="no" />
        <File Id="CodigoReadme" Source="$(var.BinDir)\README.md" KeyPath="no" />
        <File Id="CodigoLicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="no" />
        <File Id="CodigoLicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="no" />
        <File Id="CodigoAttribution" Source="$(var.BinDir)\ATTRIBUTION.md" KeyPath="no" />
        <!-- Read back by the next version's installer. -->
        <RegistryValue Root="HKCU" Key="Software\Nodalia\Codigo" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <!-- Win+R "codigo". -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\codigo.exe" Value="[#CodigoExe]" Type="string" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveSuiteFolder" Directory="NodaliaSuiteFolder" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="CodigoShortcut" Directory="ProgramMenuFolder" Guid="4F9C0D7A-2E61-4A38-9B15-D8E3A6C47F20">
        <Shortcut Id="StartMenuShortcut" Name="Código"
            Description="The Nodalia code editor and IDE"
            Target="[#CodigoExe]" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="dev.danielmiguelt.Codigo" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Nodalia\Codigo" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
